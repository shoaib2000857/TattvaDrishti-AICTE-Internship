# Core application
APP_ENV=dev
APP_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///./data/app.db
WATERMARK_SEED=replace-with-an-independent-random-secret
ALLOWED_ORIGINS=["http://localhost:3000"]
SHARING_ALLOWED_REGIONS=["USA","EU","IN","AUS"]

# Local AI models
# Enable the Hugging Face AI/human and model-family detectors alongside Ollama.
DISABLE_AI_MODELS=false
HF_MODEL_NAME=disabled
HF_TOKENIZER_NAME=disabled
HF_DEVICE=-1
HF_SCORE_THRESHOLD=0.6

# Ollama semantic misinformation analysis
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
OLLAMA_TIMEOUT_CEILING=90
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=280
OLLAMA_TEMPERATURE=0.1
OLLAMA_PROMPT_CHARS=2000

# One Ollama generation handles up to four independently identified messages.
OLLAMA_MICRO_BATCH_SIZE=4
OLLAMA_MICRO_BATCH_CHARS=8000
BATCH_OLLAMA_PARALLELISM=1

# JSON / JSONL batch ingestion
BATCH_MAX_RECORDS=5000
BATCH_MAX_FILE_BYTES=26214400
BATCH_PARALLELISM=4
BATCH_AI_MODEL_SIZE=16

# Authenticated encrypted sharing
# Generate each key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURE_TRANSFER_KEY=replace-with-a-url-safe-base64-encoded-32-byte-key
SECURE_TRANSFER_KEY_ID=tattvadrishti-demo-key-v1
SECURE_TRANSFER_NODE_ID=analyst-node
SECURE_TRANSFER_NODES=USA=http://localhost:8001,EU=http://localhost:8002,IN=http://localhost:8003,AUS=http://localhost:8004
SECURE_TRANSFER_REQUIRE_TLS=false
SECURE_TRANSFER_VERIFY_TLS=true
SECURE_TRANSFER_TIMEOUT=8
SECURE_TRANSFER_TTL_SECONDS=300

# Federated blockchain demonstration
BLOCK_ENCRYPTION_KEY=replace-with-a-different-url-safe-base64-encoded-32-byte-key
FEDERATED_NODES=http://localhost:8000,http://localhost:8001,http://localhost:8002,http://localhost:8003,http://localhost:8004
NODE_URL=http://localhost:8000
MAIN_API_URL=http://localhost:8000

# Optional image analysis integration
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
