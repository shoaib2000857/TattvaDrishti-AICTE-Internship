# Browser-visible configuration; never place private keys or API secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_NODE1_URL=http://localhost:8001
NEXT_PUBLIC_NODE2_URL=http://localhost:8002
NEXT_PUBLIC_NODE3_URL=http://localhost:8003
NEXT_PUBLIC_NODE4_URL=http://localhost:8004

# For sensitive deployments, replace this with an internal
# Nominatim-compatible reverse-geocoding endpoint.
NEXT_PUBLIC_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
